{
  "name": "@averqel/neosis-tools",
  "description": "Tool registry and execution pipeline for the AverQel NeoSIS",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-ptc-runtime": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-user-approval": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-ptc-runtime": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-user-approval": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*"
  }
}
