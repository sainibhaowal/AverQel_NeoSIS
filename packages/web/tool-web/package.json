    "@averqel/neosis-web": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-spill-local": "workspace:*",
    "@averqel/neosis-spill-policy": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-tool-call-timeout-policy": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-web": "workspace:*",
    "@averqel/neosis-web-fetch-http": "workspace:*",
    "@averqel/neosis-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
