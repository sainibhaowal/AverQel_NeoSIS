{
  "name": "@averqel/neosis-web-search-deepseek",
  "description": "AverQel-backed search provider (native web_search via the Anthropic-compatible API) for the AverQel NeoSIS web capability seam (ctx.web)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-credentials": "workspace:*",
    "@averqel/neosis-deepseek-account": "workspace:*",
    "@averqel/neosis-launch-environment": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-web": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-credentials": "workspace:*",
    "@averqel/neosis-deepseek-account": "workspace:*",
    "@averqel/neosis-credentials-local": "workspace:*",
    "@averqel/neosis-launch-environment": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-web": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-http-proxy": "workspace:*"
  }
}
