{
  "name": "@averqel/neosis-web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the AverQel NeoSIS web capability seam (ctx.web)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-web": "workspace:*",
    "@averqel/neosis-http-proxy": "workspace:*"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-web": "workspace:*",
    "@averqel/neosis-http-proxy": "workspace:*"
  }
}
