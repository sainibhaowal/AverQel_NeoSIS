{
  "name": "@averqel/neosis-user-questions",
  "description": "Abstract user-questions seam (ctx.userQuestions) for asking the human during agent runs",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/interaction/user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
