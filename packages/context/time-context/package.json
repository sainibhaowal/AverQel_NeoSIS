{
  "name": "@averqel/neosis-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-loop": "workspace:*",
    "@averqel/neosis-agent-loop-testkit": "workspace:*",
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/neosis-bash-local": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-loader-smoke": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-checkpoint-policy": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-tools": "workspace:*"
  }
}
