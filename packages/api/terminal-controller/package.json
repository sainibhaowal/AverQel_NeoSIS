{
  "name": "@averqel/neosis-api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-api-gateway"
      ],
      "external": [
        "@averqel/neosis-api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-deque": "workspace:*",
    "@averqel/neosis-lazy-require": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-api-gateway": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/neosis-remote-mock": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-util-crypto": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
