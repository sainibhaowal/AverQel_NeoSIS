{
  "name": "@averqel/neosis-terminal-bash",
  "description": "Persistent shell PTY backend over the AverQel NeoSIS subprocess terminal primitive",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-terminal": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-session-projection": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-lazy-require": "workspace:*",
    "@averqel/neosis-pwsh-local": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-loop-testkit": "workspace:*",
    "@averqel/neosis-terminal": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
