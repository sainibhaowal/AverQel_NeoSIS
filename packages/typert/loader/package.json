{
  "name": "@averqel/neosis-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/typert/loader"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-typert-registry": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-typert-registry": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "zod": "^4.4.3"
  }
}
