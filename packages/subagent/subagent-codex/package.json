{
  "name": "@averqel/neosis-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "neosis": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-sdk-protocol": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-loader-smoke": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-checkpoint-policy": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-tool-jobs": "workspace:*",
    "@averqel/neosis-tool-subagent": "workspace:*",
    "@averqel/neosis-tools": "workspace:*"
  }
}
