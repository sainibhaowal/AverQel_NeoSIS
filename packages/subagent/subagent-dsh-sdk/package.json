{
  "name": "@averqel/neosis-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-sdk-client": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-instructions": "workspace:*",
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-llm-deepseek": "workspace:*",
    "@averqel/neosis-llm-deepseek-api-key": "workspace:*",
    "@averqel/neosis-loader-smoke": "workspace:*",
    "@averqel/neosis-sdk-client": "workspace:*",
    "@averqel/neosis-sdk-protocol": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-checkpoint-policy": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-skill-filesystem": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-tool-subagent": "workspace:*"
  }
