{
  "name": "@averqel/neosis-lsp-stdio",
  "description": "Generic stdio language-server provider for the AverQel NeoSIS LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-lsp": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/neosis-fs-local": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-lsp": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
