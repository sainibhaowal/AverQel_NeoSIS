{
  "name": "@averqel/neosis-tool-lsp",
  "description": "Model-facing lsp tool over the AverQel NeoSIS LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-lsp": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-tools": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-fs-local": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-lsp": "workspace:*",
    "@averqel/neosis-lsp-stdio": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-tool-call-timeout-policy": "workspace:*",
    "@averqel/neosis-tools": "workspace:*"
  }
}
