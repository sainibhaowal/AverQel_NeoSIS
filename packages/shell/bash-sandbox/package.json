{
  "name": "@averqel/neosis-bash-sandbox",
  "description": "Sandbox-consuming implementation of the AverQel NeoSIS bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-shell": "workspace:*",
    "@averqel/neosis-bash-local": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-shell": "workspace:*",
    "@averqel/neosis-bash-local": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-sandbox-local": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/node-addon-system": "workspace:~",
    "@averqel/neosis-session-projection": "workspace:*"
  }
}
