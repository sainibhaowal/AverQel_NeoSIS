{
  "name": "@averqel/neosis-bash-local",
  "description": "Local-subprocess implementation of the AverQel NeoSIS bash executor seam",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-shell": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-shell": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
