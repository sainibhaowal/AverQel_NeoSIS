{
  "name": "@averqel/neosis-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the AverQel NeoSIS PTC execution seam",
  "version": "0.2.0-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-ptc-runtime": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-util-values": "workspace:*"
  },
  "devDependencies": {
    "@averqel/neosis-ptc-runtime": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-util-values": "workspace:*"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  }
}
