{
  "name": "@averqel/neosis-experimental-schedule-bundle",
  "description": "Optional bundle that adds Schedule, its task page, and time context to the NeoSIS Web composition",
  "version": "0.1.7-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/experimental/schedule-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["icon.svg", "locale/*.json", "lib/index.js", "cordis.patch.yml", "lib/types/**/*.d.ts"],
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-client-ui-schedule": "workspace:*",
    "@averqel/neosis-schedule": "workspace:*",
    "@averqel/neosis-time-context": "workspace:*"
  },
  "peerDependencies": { "@averqel/cordis": "workspace:~" },
  "devDependencies": { "@averqel/cordis": "workspace:~" },
  "neosis": { "bundle": { "patch": "./cordis.patch.yml" } }
}
