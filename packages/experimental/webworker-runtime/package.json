{
  "name": "@averqel/neosis-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-util-crypto": "workspace:*",
    "@noble/hashes": "^2.3.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.17.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.4",
    "readable-stream": "^4.7.0",
    "@averqel/neosis-client-web": "workspace:*"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-client-connection": "workspace:*",
    "@averqel/neosis-client-modules": "workspace:*",
    "@averqel/neosis-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-api-gateway": "workspace:*",
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/neosis-bash-sandbox": "workspace:*",
    "@averqel/neosis-client-connection": "workspace:*",
    "@averqel/neosis-client-file-upload": "workspace:*",
    "@averqel/neosis-client-modules": "workspace:*",
    "@averqel/neosis-host-webserver": "workspace:*",
    "@averqel/neosis-sandbox-local": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/node-addon-system": "workspace:~",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
