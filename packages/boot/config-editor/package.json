{
  "name": "@averqel/neosis-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-hmr": "workspace:*",
    "@averqel/cordis-plugin-include": "workspace:~",
    "@averqel/neosis-app-boot": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-atomic-write": "workspace:*",
    "yaml": "^2.8.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-hmr": "workspace:*",
    "@averqel/cordis-plugin-include": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@averqel/neosis-app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@averqel/neosis-hmr": {
      "optional": true
    }
  }
}
