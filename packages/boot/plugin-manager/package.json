{
  "name": "@averqel/neosis-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by neosis CLI, Web and agent tools",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-app-boot": "workspace:*",
    "@averqel/neosis-atomic-write": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@averqel/neosis-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-host-plugin-inventory": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-hmr": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@averqel/neosis-hmr": {
      "optional": true
    },
    "@averqel/neosis-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@averqel/neosis-package-manifest": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-host-plugin-inventory": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-hmr": "workspace:*",
    "@averqel/cordis-plugin-timer": "workspace:~",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-sandbox": "workspace:*",
    "@averqel/neosis-user-approval": "workspace:*"
  }
}
