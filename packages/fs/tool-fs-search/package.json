{
  "name": "@averqel/neosis-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@averqel/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-output-retention": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-spill": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-subprocess": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-output-retention": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-spill": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-scope": "workspace:*"
  }
}
