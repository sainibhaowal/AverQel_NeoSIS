{
  "name": "@averqel/neosis-fs-observation-policy",
  "description": "File-context policy plugin for the AverQel NeoSIS — observed-state, read-before-edit, and version-guarded write/edit added over the ctx.fs provider seam through the fs/* event gate (no service API)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/fs/fs-observation-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
