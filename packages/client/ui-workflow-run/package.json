{
  "name": "@averqel/neosis-client-ui-workflow-run",
  "description": "Durable workflow-run Conversation Node and nested member disclosure for neosis web",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/client/ui-workflow-run"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-api-session-controller",
        "@averqel/neosis-client-locale",
        "@averqel/neosis-client-ui-chat",
        "@averqel/neosis-client-ui-conversation",
        "@averqel/neosis-client-ui-renderer",
        "@averqel/neosis-client-ui-session",
        "@averqel/neosis-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/neosis-api-session-controller": "workspace:*",
    "@averqel/neosis-client-locale": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-client-test-runtime": "workspace:*",
    "@averqel/neosis-client-ui-chat": "workspace:*",
    "@averqel/neosis-client-ui-conversation": "workspace:*",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-slots": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*",
    "@averqel/neosis-client-ui-session": "workspace:*",
    "@averqel/neosis-client-ui-workspace": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-tool-workflow": "workspace:*",
    "@averqel/neosis-workflow": "workspace:*",
    "@types/react": "~18.3.1",
    "@averqel/cordis": "workspace:~",
    "react": "^18.2.0"
  }
}
