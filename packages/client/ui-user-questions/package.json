{
  "name": "@averqel/neosis-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-api-remotes",
        "@averqel/neosis-api-session-controller",
        "@averqel/neosis-client-locale",
        "@averqel/neosis-client-ui-conversation",
        "@averqel/neosis-client-ui-renderer",
        "@averqel/neosis-client-ui-session",
        "@averqel/neosis-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-api-remotes": "workspace:*",
    "@averqel/neosis-api-session-controller": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-client-locale": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-user-questions": "workspace:*",
    "@types/react": "~18.3.1",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-slots": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*",
    "@averqel/neosis-client-ui-session": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@averqel/neosis-client-ui-conversation": "workspace:*",
    "@averqel/neosis-client-ui-chat": "workspace:*",
    "@averqel/neosis-client-ui-tool": "workspace:*",
    "@averqel/neosis-client-connection": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "clsx": "^2.0.0",
    "@averqel/neosis-llm": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
