{
  "name": "@averqel/neosis-client-ui-settings-session-log",
  "description": "General settings control for Session-log upload with DeepSeek API requests",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/client/ui-settings-session-log"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-client-locale",
        "@averqel/neosis-client-ui-settings",
        "@averqel/neosis-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-api-remotes": "workspace:*",
    "@averqel/neosis-client-locale": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-client-test-runtime": "workspace:*",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*",
    "@averqel/neosis-client-ui-settings": "workspace:*",
    "@averqel/neosis-client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@averqel/neosis-client-ui-layout": "workspace:*",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
