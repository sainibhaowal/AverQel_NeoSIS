{
  "name": "@averqel/neosis-client-ui-sidebar-documentpreview",
  "description": "Extensible Sidebar previews for Office documents, spreadsheets, Markdown, code, images, PDF, HTML, and plain text",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/client/ui-sidebar-documentpreview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-api-gateway",
        "@averqel/neosis-api-workspace-files",
        "@averqel/neosis-client-resources",
        "@averqel/neosis-client-ui-sidebar-right",
        "@averqel/neosis-client-ui-session",
        "@averqel/neosis-api-remotes",
        "@averqel/neosis-client-locale",
        "@averqel/neosis-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-api-gateway": "workspace:*",
    "@averqel/neosis-api-remotes": "workspace:*",
    "@averqel/neosis-api-workspace-files": "workspace:*",
    "@averqel/neosis-client-connection": "workspace:*",
    "@averqel/neosis-client-locale": "workspace:*",
    "@averqel/neosis-client-resources": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-client-test-runtime": "workspace:*",
    "@averqel/neosis-client-ui-dockkit": "workspace:*",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*",
    "@averqel/neosis-client-ui-session": "workspace:*",
    "@averqel/neosis-client-ui-settings": "workspace:*",
    "@averqel/neosis-client-ui-sidebar-right": "workspace:*",
    "@averqel/neosis-client-ui-slots": "workspace:*",
    "@averqel/neosis-office-to-pdf": "workspace:*",
    "@averqel/neosis-host-webserver": "workspace:*",
    "@averqel/neosis-office-to-pdf": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-util-workspace-path": "workspace:*",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@testing-library/react": "^16.1.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.11",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "^0.8.3",
    "papaparse": "5.5.3",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  }
}
