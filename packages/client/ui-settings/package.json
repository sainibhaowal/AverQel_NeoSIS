{
  "name": "@averqel/neosis-client-ui-settings",
  "description": "Settings domain base plugin: shared configuration forms and the canonical settings slot-type contract",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/client/ui-settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "neosis": {
    "client": {
      "inject": [
        "@averqel/neosis-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-api-remotes": "workspace:*",
    "@averqel/neosis-client-store": "workspace:*",
    "@averqel/neosis-client-test-runtime": "workspace:*",
    "@averqel/neosis-client-ui-slots": "workspace:*",
    "@averqel/neosis-settings": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@averqel/neosis-util-values": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@averqel/schemastery": "workspace:~"
  }
}
