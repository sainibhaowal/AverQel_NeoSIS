{
  "name": "@averqel/neosis-ui-brand",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "description": "AverQel NeoSIS brand occupants for the sidebar and UI",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "neosis": {
    "client": {
      "external": []
    }
  },
  "dependencies": {
    "@averqel/cordis": "workspace:*",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-sidebar": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:*",
    "@averqel/neosis-client-ui-primitives": "workspace:*",
    "@averqel/neosis-client-ui-sidebar": "workspace:*",
    "@averqel/neosis-client-ui-renderer": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
