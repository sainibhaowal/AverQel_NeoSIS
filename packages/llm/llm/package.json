{
  "name": "@averqel/neosis-llm",
  "description": "Provider-neutral LLM service interface for the AverQel NeoSIS",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/llm/llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./assistant-stream": {
      "types": "./lib/types/assistant-stream.d.ts",
      "default": "./lib/types/assistant-stream.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "dependencies": {
    "@averqel/neosis-util-crypto": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@averqel/neosis-timeout": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@averqel/neosis-attachment": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
