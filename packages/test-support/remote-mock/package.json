{
  "name": "@averqel/neosis-remote-mock",
  "description": "Endpoint-named mock for Typert Remote traffic: unary answers and stream scripts per <namespace>/<method>, live stream control, a log, and the Connection carrier face whole-client specs install",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/test-support/remote-mock"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@vitest/spy": "^4.1.8"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-api-settings-controller": "workspace:*",
    "@averqel/neosis-client-connection": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
