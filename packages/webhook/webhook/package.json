{
  "name": "@averqel/neosis-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed AverQel NeoSIS Sessions",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/webhook/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-default-model": "workspace:*",
    "@averqel/neosis-agent-preset-registry": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-permission-presets": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-title": "workspace:*",
    "@averqel/neosis-workspace": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-include": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-default-model": "workspace:*",
    "@averqel/neosis-agent-preset-registry": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-permission-presets": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-title": "workspace:*",
    "@averqel/neosis-workspace": "workspace:*"
  },
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-util-values": "workspace:*"
  }
}
