{
  "name": "@averqel/neosis-cordis-host-runner",
  "description": "Dynamic package definition registry, host-half sandbox lifecycle, and invoke handler table for model-mounted dual-half packages",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/extensions/cordis-host-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-timer": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*"
  }
}
