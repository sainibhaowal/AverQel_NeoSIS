{
  "name": "@averqel/neosis-office-to-pdf",
  "description": "Shared Office-to-PDF conversion with bounded queues and caching",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/document/office-to-pdf"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/cordis-plugin-include": "workspace:~",
    "@averqel/neosis-api-workspace-files": "workspace:*",
    "@averqel/neosis-fs": "workspace:*",
    "@averqel/neosis-session": "workspace:*"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "zod": "^4.4.3"
  }
}
