{
  "name": "@averqel/neosis-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process AverQel NeoSIS SDK clients",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-attachment": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-llm-deepseek": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-sdk-protocol": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-loop": "workspace:*",
    "@averqel/neosis-agent-loop-testkit": "workspace:*",
    "@averqel/neosis-attachment": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-llm-deepseek": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-sdk-protocol": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-subagent": "workspace:*"
  }
}
