{
  "name": "@averqel/neosis-schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@averqel/neosis-api-session-controller": "workspace:*",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-persistence": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-storage-domain": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "@averqel/neosis-workspace": "workspace:*",
    "@averqel/cordis": "workspace:~"
  },
  "dependencies": {
    "@averqel/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@averqel/neosis-api-session-controller": "workspace:*",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-loop": "workspace:*",
    "@averqel/neosis-agent-loop-testkit": "workspace:*",
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-persistence": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-storage-domain": "workspace:*",
    "@averqel/neosis-tools": "workspace:*",
    "@averqel/neosis-typert-protocol": "workspace:*",
    "@averqel/neosis-workspace": "workspace:*",
    "@averqel/cordis": "workspace:~"
  }
}
