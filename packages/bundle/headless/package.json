{
  "name": "@averqel/neosis-headless",
  "description": "The neosis one-shot bundle: a direct core Agent/Session runner over neosis-base with no Host, HTTP, or browser layer",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "neosis": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@averqel/neosis-brand": "workspace:*",
    "@averqel/neosis-cmdline": "workspace:*",
    "@averqel/neosis-util-values": "workspace:*",
    "@averqel/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-default-model": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-query": "workspace:*",
    "@averqel/neosis-fs": "workspace:*"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~",
    "@averqel/cordis-plugin-loader": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-default-model": "workspace:*",
    "@averqel/neosis-agent-loop": "workspace:*",
    "@averqel/neosis-agent-loop-testkit": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-query": "workspace:*",
    "@averqel/neosis-fs": "workspace:*"
  }
}
