{
  "name": "@averqel/neosis-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one AverQel adapter, persistent shell, and JSONL sessions",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainibhaowal/AverQel_Neosis.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "neosis": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@averqel/cordis-plugin-timer": "workspace:~",
    "@averqel/neosis-agent": "workspace:*",
    "@averqel/neosis-agent-loop": "workspace:*",
    "@averqel/neosis-deepseek-llm-api-extensions": "workspace:*",
    "@averqel/neosis-invariants": "workspace:*",
    "@averqel/neosis-jobs-local": "workspace:*",
    "@averqel/neosis-llm": "workspace:*",
    "@averqel/neosis-llm-deepseek": "workspace:*",
    "@averqel/neosis-llm-retry": "workspace:*",
    "@averqel/neosis-mcp-resources": "workspace:*",
    "@averqel/neosis-plugin-package-inventory-deepseek": "workspace:*",
    "@averqel/neosis-sandbox-local": "workspace:*",
    "@averqel/neosis-sandbox-policy": "workspace:*",
    "@averqel/neosis-scope": "workspace:*",
    "@averqel/neosis-sdk-app": "workspace:*",
    "@averqel/neosis-sdk-jsonrpc-server": "workspace:*",
    "@averqel/neosis-session": "workspace:*",
    "@averqel/neosis-session-log-deepseek": "workspace:*",
    "@averqel/neosis-session-persistence-jsonl": "workspace:*",
    "@averqel/neosis-session-projection": "workspace:*",
    "@averqel/neosis-session-title": "workspace:*",
    "@averqel/neosis-subprocess-local": "workspace:*",
    "@averqel/neosis-system-prompt": "workspace:*",
    "@averqel/neosis-terminal": "workspace:*",
    "@averqel/neosis-terminal-bash": "workspace:*",
    "@averqel/neosis-tool-bash-persistent": "workspace:*",
    "@averqel/neosis-tool-pwsh-persistent": "workspace:*",
    "@averqel/neosis-tools": "workspace:*"
  },
  "peerDependencies": {
    "@averqel/cordis": "workspace:~"
  },
  "devDependencies": {
    "@averqel/cordis": "workspace:~"
  }
}
