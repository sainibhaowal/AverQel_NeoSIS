# Copy to .env.linux (Git ignored). Use UTF-8 and quote values containing # or spaces.
# Linux packaging runs on a matching Linux architecture and bundles the pinned LibreOffice payload.
NEOSIS_DESKTOP_APP_ID=com.averqel.neosis
NEOSIS_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
DOWNLOAD_TEST_RELEASE_ID=

# Optional npm registry for the bundled NeoSIS runtime install.
# NEOSIS_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/

# The selected mandatory-update origin is required for a complete packaged release.
NEOSIS_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
NEOSIS_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
NEOSIS_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Optional upload configuration; packaging does not require these credentials.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=
